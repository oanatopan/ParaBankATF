<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SmokeSuite" parallel="classes" thread-count="3">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="utils.TestListener"/>
    </listeners>

    <test name="Smoke Tests">
        <classes>
            <class name="tests.RegisterTest"/>
            <class name="tests.LoginValidTest"/>
            <class name="tests.LoginInvalidTest"/>
            <class name="tests.BillPayTest"/>
            <class name="tests.OpenAccountTest"/>
            <class name="tests.LogOutTest"/>
        </classes>
    </test>

</suite>