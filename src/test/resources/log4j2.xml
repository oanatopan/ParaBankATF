<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" packages="utils">
<Appenders>
    <Console name="ConsoleAppender" target="SYSTEM_OUT">
        <PatternLayout pattern="%d{HH:mm:ss} [%t] %-5level - %msg%n"/>
    </Console>
    <File name="FileAppender" fileName="logs/test-execution.log">
        <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level - %msg%n"/>
    </File>
    <AllureAppender name="AllureAppender">
        <PatternLayout pattern="%msg%n"/>
    </AllureAppender>
</Appenders>
<Loggers>
    <Root level="info">
        <AppenderRef ref="ConsoleAppender"/>
        <AppenderRef ref="FileAppender"/>
        <AppenderRef ref="AllureAppender"/>
    </Root>
</Loggers>
</Configuration>